# Copy to .env and fill in. Never commit .env. Full reference: docs/architecture/environment.md
DF_ENV=development
DF_SECRET_KEY=                       # required in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
DF_DATABASE_URL=sqlite:///./state/dealerflow.db
DF_BASE_URL=http://127.0.0.1:8000    # public URL; used in unsubscribe links and webhooks
DF_TIMEZONE=America/Chicago

# Sender identity (CAN-SPAM: real name, valid physical postal address)
DF_BUSINESS_NAME=
DF_BUSINESS_POSTAL_ADDRESS=
DF_SENDER_NAME=
DF_SENDER_EMAIL=

# Providers: mock = SIMULATED (default). Real ones need credentials below.
DF_EMAIL_PROVIDER=mock               # mock | smtp | gmail
DF_CALENDAR_PROVIDER=mock            # mock | google
DF_ZOOM_PROVIDER=mock                # mock | zoom
DF_CALL_PROVIDER=manual              # manual | twilio | mock

# Real sending stays off until you set this AND an admin authorizes live operation in the Agent page.
DF_OUTREACH_SENDING_ENABLED=false
DF_OUTREACH_DAILY_CAP=25
DF_OUTREACH_PER_PROSPECT_COOLDOWN_DAYS=7
DF_OUTREACH_MAX_TOUCHES_PER_PROSPECT=3

# SMTP/IMAP
DF_SMTP_HOST=
DF_SMTP_PORT=587
DF_SMTP_USERNAME=
DF_SMTP_PASSWORD=
DF_IMAP_HOST=
DF_IMAP_USERNAME=
DF_IMAP_PASSWORD=

# Google (Gmail + Calendar) — see scripts/google_oauth.py
DF_GOOGLE_CLIENT_ID=
DF_GOOGLE_CLIENT_SECRET=
DF_GOOGLE_REFRESH_TOKEN=
DF_GOOGLE_CALENDAR_ID=primary

# Zoom Server-to-Server OAuth app
DF_ZOOM_ACCOUNT_ID=
DF_ZOOM_CLIENT_ID=
DF_ZOOM_CLIENT_SECRET=
DF_ZOOM_WEBHOOK_SECRET_TOKEN=

# Twilio click-to-call (optional)
DF_TWILIO_ACCOUNT_SID=
DF_TWILIO_AUTH_TOKEN=
DF_TWILIO_CALLER_ID=
DF_AGENT_PHONE=

# Lead discovery
DF_GOOGLE_PLACES_API_KEY=
DF_WEBSITE_RESEARCH_ENABLED=false
DF_HTTP_USER_AGENT=dealerflow-research/0.1 (+mailto:you@yourdomain.com)

# Optional daily digest
DF_NOTIFY_EMAIL=

# --- Phase 2: inventory, listings, publishing ---
DF_MAX_UPLOAD_BYTES=10485760
DF_MAX_FEED_BYTES=26214400
DF_FEED_TIMEOUT_SECONDS=30
DF_PUBLISH_MAX_ATTEMPTS=5
# Feed credentials: one variable per authorised feed, referenced by name on the inventory source.
# DF_FEED_ALPHA_DMS=
# Listing prose uses the deterministic template generator unless both of these are set.
DF_LISTING_AI_ENABLED=false
DF_ANTHROPIC_API_KEY=
DF_AI_MODEL=claude-opus-5-5
DF_AI_EFFORT=medium
# Nothing is sent to Meta unless this is true AND the dealership's connection is authorised in the app.
DF_META_LIVE_PUBLISHING_ALLOWED=false
DF_META_GRAPH_API_VERSION=v24.0
# Meta system-user tokens: one per dealership, referenced by name on the channel connection.
# DF_META_TOKEN_ALPHA=

# --- Phase 4: clients, finance, SEO, reporting ---
DF_CLIENT_EMAIL_SENDING_ENABLED=false
DF_ATTACHMENTS_DIR=./state/attachments
DF_API_RATE_LIMIT_PER_MINUTE=300
DF_PAGESPEED_API_KEY=
DF_STRIPE_WEBHOOK_SECRET=
# Phase 4 free-text AI (reports/SEO summaries); uses DF_ANTHROPIC_API_KEY above.
DF_AI_ENABLED=false
DF_RETENTION_DAYS_CONVERSATIONS=365

# --- Customer messaging, pilot mode and account security (integration stages 3-4) -------------------
# Pilot mode (default true): a LIVE send of any kind reaches only allowlisted internal test recipients
# (Pilot console /admin/pilot; emails in DF_TEST_INBOXES also count).
DF_PILOT_MODE=true
# Master switch for real replies to car buyers. Off = every customer reply is SIMULATED (sandbox).
DF_LIVE_CUSTOMER_MESSAGING_ENABLED=false
# Optional Claude rephrasing of grounded customer drafts (also needs DF_AI_ENABLED + DF_ANTHROPIC_API_KEY).
DF_CUSTOMER_AI_REPHRASE_ENABLED=false
# Inbound webhook secrets (empty = the webhook is refused). Twilio SMS uses DF_TWILIO_AUTH_TOKEN above.
DF_META_APP_SECRET=
DF_META_VERIFY_TOKEN=
# Agency admins must use two-factor authentication. Empty = required in production only. false is refused in production.
DF_REQUIRE_ADMIN_MFA=
DF_PASSWORD_RESET_TTL_MINUTES=60
DF_CHAT_MAX_MESSAGES_PER_VISITOR_PER_HOUR=30
