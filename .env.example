# Copy to .env for local development. Never commit real secrets.

# --- core ---
APP_ENV=development
# SQLite for dev/tests; PostgreSQL for production, e.g. postgresql+psycopg://user:pass@host:5432/cardealer
DATABASE_URL=sqlite:///./data/app.db
# base64-encoded 32 bytes; required to store any credential. Generate:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
MAX_UPLOAD_BYTES=10485760
# Comma-separated origins if the UI is served from another host (empty = same-origin only)
CORS_ORIGINS=

# --- AI (Anthropic Claude) ---
# Template generator is used unless LISTING_AI_ENABLED=true AND a key is present.
ANTHROPIC_API_KEY=
LISTING_AI_ENABLED=false
OUTREACH_AI_ENABLED=false
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# --- background worker ---
WORKER_POLL_SECONDS=2
AGENT_TICK_SECONDS=120
FEED_TIMEOUT_SECONDS=30
MAX_FEED_BYTES=26214400
PUBLISH_MAX_ATTEMPTS=5

# --- Meta catalog (Automotive Inventory Ads) ---
# Nothing is sent to Meta unless this is true AND the dealership's connection is authorised for live publishing.
META_LIVE_PUBLISHING_ALLOWED=false
META_GRAPH_API_VERSION=v24.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# --- outreach agent ---
# Live providers (Gmail/Calendar/Places) are blocked unless this is true AND a platform admin authorises
# both the integration and the campaign in the app.
OUTREACH_LIVE_ALLOWED=false
# Public URL recipients can reach for one-click unsubscribe links.
PUBLIC_BASE_URL=http://localhost:8000
# Secret for signing unsubscribe tokens (falls back to APP_ENCRYPTION_KEY).
UNSUBSCRIBE_SECRET=

# --- seed script only ---
SEED_ADMIN_PASSWORD=
SEED_DEALER_PASSWORD=
