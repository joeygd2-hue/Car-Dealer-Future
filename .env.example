# Copy to .env for local development. Never commit real values.
# ---- core ----
ENVIRONMENT=development               # development | test | production
SECRET_KEY=change-me-to-64-random-chars
DATABASE_URL=sqlite:///./data/app.db  # production: postgresql+psycopg://user:pass@host:5432/db
BASE_URL=http://localhost:8000        # production must be https://
CREDENTIALS_ENCRYPTION_KEY=           # python -m app.cli generate-key (required in production)
LOG_LEVEL=INFO
SESSION_TTL_HOURS=12
ATTACHMENTS_DIR=./data/attachments
MAX_UPLOAD_BYTES=10485760
BUSINESS_TIMEZONE=America/Chicago
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=300

# ---- company identity (outreach compliance) ----
COMPANY_NAME=Dealer Growth Services
COMPANY_POSTAL_ADDRESS=               # REQUIRED before live outreach (CAN-SPAM)
COMPANY_REPLY_TO=
OUTREACH_FROM_ADDRESS=

# ---- email sending: sandbox (default, never sends) | smtp ----
EMAIL_PROVIDER=sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---- inbox monitoring: sandbox | imap ----
INBOX_PROVIDER=sandbox
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
INBOUND_WEBHOOK_SECRET=               # HMAC secret for POST /api/v1/webhooks/inbound-email

# ---- calendar + video: sandbox | google ----
CALENDAR_PROVIDER=sandbox
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ---- data sources ----
GOOGLE_PLACES_API_KEY=                # Places API (New) Text Search
PAGESPEED_API_KEY=                    # PageSpeed Insights API v5

# ---- payments ----
STRIPE_WEBHOOK_SECRET=                # whsec_... (use a test-mode endpoint first)

# ---- AI (optional; templates/rules are used when disabled) ----
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- crawler / worker ----
CRAWLER_USER_AGENT=DealerGrowthAuditBot/1.0 (+contact: you@example.com)
CRAWLER_MAX_PAGES=50
CRAWLER_DELAY_SECONDS=1.0
CRAWLER_TIMEOUT_SECONDS=15
WORKER_POLL_SECONDS=5
JOB_LEASE_SECONDS=300
