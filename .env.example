# Copy to .env (git-ignored) and fill in. Never commit real secrets.
APP_ENV=development                 # development | test | production
BASE_URL=http://localhost:8000      # public URL; used in links, webhooks (Twilio signature), unsubscribe/booking pages
DATABASE_URL=sqlite:///./data/app.db  # production: postgresql+psycopg://user:pass@host/db (add the driver dependency)
SECRET_KEY=change-me
# Fernet key for encrypting stored provider credentials:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
SESSION_TTL_HOURS=12

# MASTER SWITCH. While false, every provider resolves to its sandbox adapter (nothing leaves the system).
# Live use ALSO requires a recorded live authorization per scope in the admin workspace.
LIVE_INTEGRATIONS_ENABLED=false

# Optional Claude rephrasing (grounded + validated; never adds facts). Also needs the "llm.anthropic" authorization.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Meta Messenger Platform (platform app). Page tokens are stored per dealership, encrypted, via the admin UI.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Staff notification email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Outreach agent sender identity — CAN-SPAM requires a valid physical postal address.
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_EMAIL=
OUTREACH_COMPANY_NAME=
OUTREACH_POSTAL_ADDRESS=
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_USERNAME=
OUTREACH_SMTP_PASSWORD=
OUTREACH_IMAP_HOST=
OUTREACH_IMAP_PORT=993
OUTREACH_IMAP_USERNAME=
OUTREACH_IMAP_PASSWORD=
OUTREACH_IMAP_FOLDER=INBOX

# Prospect discovery (Google Places API New). Only place_id is stored long-term.
GOOGLE_PLACES_API_KEY=

# Operator calendar + video for sales meetings (and default OAuth client for dealership calendars)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_STALE_SECONDS=90
